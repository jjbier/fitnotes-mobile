# ── Supabase ──────────────────────────────────────────────────────────────────
# Web (Next.js) — copy to apps/web/.env.local
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Mobile (Expo) — copy to apps/mobile/.env
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Google Drive backup (optional) ────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Enable Drive API → OAuth 2.0 Client ID (Web application)
# Add authorized redirect URI: ${NEXT_PUBLIC_APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Canonical URL used as OAuth redirect base (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
