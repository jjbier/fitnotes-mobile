{
  "name": "@fitnotes/core",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./stores/*": "./src/stores/*.ts",
    "./utils/*": "./src/utils/*.ts",
    "./schemas": "./src/schemas/index.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@fitnotes/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^2.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.0.0"
  }
}
